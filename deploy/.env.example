# Copy this file to .env on the server and replace every CHANGE_ME value.

TZ=Asia/Shanghai
NEW_API_PORT=127.0.0.1:3000
FRONTEND_BASE_URL=https://api.jiatuc.cn
NEW_API_DOMAIN=api.jiatuc.cn

POSTGRES_USER=newapi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=new-api

REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

SESSION_SECRET=CHANGE_ME_RANDOM_64_HEX
CRYPTO_SECRET=CHANGE_ME_RANDOM_64_HEX

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1
STREAMING_TIMEOUT=300
RELAY_IDLE_CONN_TIMEOUT=90


